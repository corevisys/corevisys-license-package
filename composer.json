{
    "name": "corevisys/laravel-license-client",
    "description": "Official Laravel client SDK for the CoreVisys licensing platform — activate, verify, and monitor software licenses with signed, offline-capable verification.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "license", "licensing", "corevisys", "saas"],
    "authors": [
        {
            "name": "CoreVisys",
            "email": "support@corevisys.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "ext-openssl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "CoreVisys\\License\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoreVisys\\License\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CoreVisys\\License\\CoreVisysServiceProvider"
            ],
            "aliases": {
                "CoreVisysLicense": "CoreVisys\\License\\Facades\\CoreVisysLicense"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
